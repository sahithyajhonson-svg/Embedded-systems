Description: Monitoring and Controlling DHT11 Sensor and Buzzer Using Adafruit IO Dashboard
The system uses the Adafruit IO cloud platform to monitor temperature and humidity data from the DHT11 sensor and control a buzzer through an interactive dashboard. The DHT11 sensor continuously measures the surrounding temperature and humidity and sends the collected data to Adafruit IO using an internet-connected microcontroller, such as an ESP8266 or ESP32.
The Adafruit IO dashboard displays the real-time temperature and humidity readings using gauges, charts, or numerical displays. Users can remotely monitor the environmental conditions from a mobile phone or computer. A buzzer is connected to the microcontroller to provide an audible alert when the measured temperature or humidity exceeds a predefined threshold.
The buzzer can also be controlled manually through a switch or button on the Adafruit IO dashboard. When the user turns the buzzer ON or OFF from the dashboard, the command is sent through Adafruit IO to the microcontroller, which controls the buzzer accordingly. This system enables real-time sensor monitoring, remote buzzer control, and environmental condition alerts through an easy-to-use cloud-based interface.

 Main Features
- Temperature monitoring: Displays temperature readings from the DHT11 sensor.
- Humidity monitoring: Shows real-time humidity values on the dashboard.
- Buzzer control: Allows users to switch the buzzer ON or OFF remotely.
- Automatic alerts: Activates the buzzer when predefined temperature or humidity limits are exceeded, if this feature is programmed.
- Cloud-based monitoring: Enables access to sensor data from anywhere with an internet connection.
- Data visualization: Uses dashboard gauges and charts to display current and historical sensor readings, depending on the configured widgets.

# code:
#include <Arduino.h>
#include <DHT.h>
#include "AdafruitIO_WiFi.h"

// Adafruit IO credentials
#define IO_USERNAME   "YOUR_NAME"
#define IO_KEY       "YOUR_ PASSWORD"
// Wi-Fi credentials
#define WIFI_SSID "moto g45"
#define WIFI_PASS "************"

// Sensor and buzzer
#define DHT_PIN 4
#define BUZZER_PIN 25
#define DHT_TYPE DHT11

const float ON_TEMP = 30.0;
const float OFF_TEMP = 29.0;

struct SensorData {
  float temp;
  float humidity;
};

DHT dht(DHT_PIN, DHT_TYPE);

AdafruitIO_WiFi io(IO_USERNAME, IO_KEY,
                   WIFI_SSID, WIFI_PASS);

AdafruitIO_Feed *tempFeed = io.feed("temperature");
AdafruitIO_Feed *humFeed = io.feed("humidity");

QueueHandle_t displayQueue;
QueueHandle_t alertQueue;

void sensorTask(void *p) {
  SensorData d;
  unsigned long lastUpload = 0;

  while (true) {
    d.temp = dht.readTemperature();
    d.humidity = dht.readHumidity();

    if (!isnan(d.temp) && !isnan(d.humidity)) {
      xQueueOverwrite(displayQueue, &d);
      xQueueOverwrite(alertQueue, &d);

      // Upload every 10 seconds
      if (millis() - lastUpload >= 10000) {
        lastUpload = millis();

        if (io.status() == AIO_CONNECTED) {
          tempFeed->save(d.temp);
          humFeed->save(d.humidity);

          Serial.println("Data sent to Adafruit IO");
        } else {
          Serial.println("Adafruit IO disconnected");
        }
      }
    } else {
      Serial.println("DHT11 reading failed");
    }

    vTaskDelay(pdMS_TO_TICKS(2500));
  }
}

void displayTask(void *p) {
  SensorData d;

  while (true) {
    if (xQueueReceive(displayQueue, &d,
                      portMAX_DELAY) == pdTRUE) {
      Serial.print("Temp: ");
      Serial.print(d.temp);
      Serial.print(" C | Hum: ");
      Serial.println(d.humidity);
    }
  }
}

void alertTask(void *p) {
  SensorData d;
  bool alarm = false;

  while (true) {
    if (xQueueReceive(alertQueue, &d,
                      portMAX_DELAY) == pdTRUE) {
      if (d.temp > ON_TEMP) {
        alarm = true;
      }

      if (d.temp < OFF_TEMP) {
        alarm = false;
      }

      digitalWrite(BUZZER_PIN, alarm ? HIGH : LOW);
    }
  }
}

void setup() {
  Serial.begin(115200);

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  dht.begin();

  displayQueue = xQueueCreate(1, sizeof(SensorData));
  alertQueue = xQueueCreate(1, sizeof(SensorData));

  if (displayQueue == NULL || alertQueue == NULL) {
    Serial.println("Queue creation failed!");
    while (true) {
      delay(1000);
    }
  }

  // Connect to Adafruit IO
  Serial.println("Connecting to Adafruit IO...");
  io.connect();

  // Wait for connection while servicing MQTT
  while (io.status() < AIO_CONNECTED) {
    io.run();
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nAdafruit IO connected!");

  xTaskCreate(sensorTask, "Sensor", 4096, NULL, 2, NULL);
  xTaskCreate(displayTask, "Display", 3072, NULL, 1, NULL);
  xTaskCreate(alertTask, "Alert", 3072, NULL, 3, NULL);
}

void loop() {
  // Keep Wi-Fi and MQTT connection alive
  io.run();
  vTaskDelay(pdMS_TO_TICKS(10));
}
